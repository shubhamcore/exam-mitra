# ===== Exam Mitra — Environment Configuration =====

# Required: Get a FREE Gemini API key from https://aistudio.google.com/apikey
# (For local dev. On Cloud Run, use Vertex AI with the service account's credentials.)
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use (Flash recommended: fastest & cheapest)
GEMINI_MODEL=gemini-2.0-flash

# Deployment mode: "local" or "cloud" (auto-detected if running on GCP)
ENVIRONMENT=local

# Google Cloud Project ID (set this when deploying to Cloud Run)
GOOGLE_CLOUD_PROJECT=

# GCP region (default: us-central1)
GOOGLE_CLOUD_REGION=us-central1

# Firestore collection prefix (for separating dev/prod data)
FIRESTORE_COLLECTION=exam_mitra

# Optional: SendGrid API key for daily email reminders (skip if not using)
# SENDGRID_API_KEY=
# FROM_EMAIL=noreplay@exammitra.app
